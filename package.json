{
  "name": "agent-loom",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "TypeScript CLI and SDK for AI agents to discover and invoke plugins, reuse artifacts across sessions, and inspect provenance. Pi runtime support. Alpha.",
  "keywords": ["ai-agents", "agent-tools", "agent-sdk", "agent-plugins", "artifact-provenance", "artifact-lineage", "session-management", "pi-agent", "typescript", "cli"],
  "homepage": "https://github.com/tgwrite/Agent_Loom",
  "repository": { "type": "git", "url": "https://github.com/tgwrite/Agent_Loom.git" },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "loom": "./bin/loom.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/container-core/src/index.d.ts",
      "import": "./dist/packages/container-core/src/index.js"
    },
    "./runtime-pi": {
      "types": "./dist/packages/runtime-pi/src/index.d.ts",
      "import": "./dist/packages/runtime-pi/src/index.js"
    },
    "./agent": {
      "types": "./dist/packages/container-core/src/agent.d.ts",
      "import": "./dist/packages/container-core/src/agent.js"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "loom": "node bin/loom.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "test:lightweight": "node test/lightweight/run.mjs",
    "test:governance": "node test/lightweight/governance.mjs",
    "test:composite": "node test/composite/run.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "privacy:history": "node scripts/privacy-check.mjs --history",
    "check": "npm run typecheck && npm test && npm run privacy:check",
    "demo": "node examples/c2-analysis-application/demo.ts",
    "demo:agent": "node examples/agent-services-demo.mjs",
    "package:local": "node scripts/package-local.mjs",
    "package:verify": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
